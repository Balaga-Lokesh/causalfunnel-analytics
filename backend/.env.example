# Port the API listens on
PORT=4000

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/causalfunnel?retryWrites=true&w=majority

# Comma-separated origins allowed to call the read (dashboard) APIs.
# The ingest endpoint (POST /api/events) accepts any origin so the tracker can run on any site.
DASHBOARD_ORIGINS=http://localhost:3000
